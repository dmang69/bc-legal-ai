# Production / staging secrets template — copy to .env.production (gitignored)
# NEVER commit the real file.

APP_MODE=production

# --- Public URLs (no trailing slash) ---
# API origin seen by browsers (after TLS)
PUBLIC_API_URL=https://api.example.com
# UI origin (CORS + cookie context)
PUBLIC_UI_URL=https://app.example.com

# FastAPI CORS allowlist (must match UI origin)
CORS_ORIGINS=https://app.example.com

# Cookies over HTTPS
ALA_COOKIE_SECURE=1
ALA_COOKIE_SAMESITE=lax

# --- Postgres (required for multi-user / multi-worker) ---
POSTGRES_USER=ala
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=ala
# Host network from API container:
ALA_POSTGRES_URL=postgresql://ala:CHANGE_ME_STRONG_PASSWORD@postgres:5432/ala
ALA_PG_POOL=1
ALA_PG_POOL_MIN=2
ALA_PG_POOL_MAX=20

# Optional Redis
ALA_REDIS_URL=redis://redis:6379/0

# Publish API port on host (TLS proxy usually binds 443 → this)
API_PUBLISH_PORT=8000

# --- AI (Puter browser base + fail-closed server LLM gates) ---
# Puter = AI base (client-side user-pays). Server keys still fail-closed.
ALA_MODEL_PROVIDER=puter
ALA_PUTER_MODEL=gpt-5-nano
ALA_ALLOW_EXTERNAL_LLM=0
ALA_WEB_RESEARCH=0
# ALA_OLLAMA_URL=http://host.docker.internal:11434
# OPENAI_API_KEY=

# --- Frontend build-time (set when building UI image/static) ---
# VITE_API_BASE_URL=https://api.example.com
# VITE_APP_MODE=private
# VITE_PUTER_MODEL=gpt-5-nano
