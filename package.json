{
  "name": "enterprise-ai-platform",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "docker compose -f docker-compose.yml up",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "cd apps/api && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "build": "pnpm --filter web build",
    "test:api": "cd apps/api && pytest",
    "lint:web": "pnpm --filter web lint",
    "migrate": "cd apps/api && alembic upgrade head",
    "migrate:create": "cd apps/api && alembic revision --autogenerate -m"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
