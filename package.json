{
  "name": "bc-legal-ai",
  "version": "1.0.1",
  "private": true,
  "description": "BC Legal AI Associate — monorepo root (API + platform-ui)",
  "scripts": {
    "dev": "npm run dev --prefix apps/platform-ui",
    "dev:ui": "npm run dev --prefix apps/platform-ui",
    "dev:api": "python -m uvicorn backend.api.main:app --reload --host 127.0.0.1 --port 8000",
    "debug:ui": "npm run debug --prefix apps/platform-ui",
    "build": "npm run build --prefix apps/platform-ui",
    "build:ui": "npm run build --prefix apps/platform-ui",
    "preview:ui": "npm run preview --prefix apps/platform-ui",
    "typecheck": "npm run typecheck --prefix apps/platform-ui",
    "test:api": "python -m pytest tests -q -m \"not postgres_required\"",
    "scan:confidential": "python scripts/scan_confidential.py .",
    "smoke": "python scripts/production_smoke.py --base http://127.0.0.1:8000"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
