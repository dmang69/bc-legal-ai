{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BC Legal AI Associate",
  "version": "0.1.2",
  "identifier": "ca.bclegalai.associate",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../platform-ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --prefix ../platform-ui",
    "frontendDist": "../../platform-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BC Legal AI Associate",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: wss:; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Conversational legal AI workspace",
    "longDescription": "A human-supervised conversational legal research, evidence, drafting, and matter-management workspace. Not legal advice.",
    "copyright": "Copyright Â© BC Legal AI Project",
    "publisher": "BC Legal AI Project",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzQkI3M0Q1MENENjk2NEMKUldSTWx0WU0xWE83azg0QzdpcHJCb0pBSjc0UXdxVVRxaWdsdjJwV0cwZElYcUYrRy9SMGFJM0sK",
      "endpoints": [
        "https://github.com/dmang69/bc-legal-ai/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

