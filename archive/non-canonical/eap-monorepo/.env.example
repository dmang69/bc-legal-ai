# -----------------------------------------------------------------------------
# Root environment for local development.
# Copy to .env and adjust. NEVER commit real secrets.
# -----------------------------------------------------------------------------

# Environment
ENVIRONMENT=development

# CORS / origins allowed to hit the API with credentials
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- API ---------------------------------------------------------------------
# Postgres connection (used by docker-compose and by the api container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=enterprise_ai
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/enterprise_ai

# Cookie sessions — set 1 in production (requires HTTPS)
EAP_COOKIE_SECURE=0

# Registration is closed after first user unless one of these is set
EAP_ENABLE_REGISTRATION=0
EAP_BOOTSTRAP_TOKEN=

# AI provider — 'mock' or 'openai-compatible'
AI_PROVIDER=mock
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Upload directory inside the api container
UPLOAD_DIR=/data/uploads

# --- Web ---------------------------------------------------------------------
# The URL the browser (and the Next.js server) uses to reach the API.
# In docker-compose, the browser hits the api via the exposed host port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
