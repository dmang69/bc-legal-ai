# =============================================================================
# BC Legal AI Associate — environment template
# Copy to `.env` (gitignored). Never commit real secrets or client matter data.
# Full reference: docs/ENVIRONMENT.md
# =============================================================================

# --- Runtime mode ---
# development | public_demo | production | staging
APP_MODE=development

# Comma-separated CORS origins (required outside development; no wildcards)
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# --- Database ---
# SQLite (default local/dev/tests). Absolute path recommended in production hosts.
# ALA_SQLITE_PATH=./data/ala_platform.sqlite3
#
# Postgres (required for multi-worker / multi-user). Prefer secrets manager in prod.
# ALA_POSTGRES_URL=postgresql://ala:CHANGE_ME@localhost:5432/ala
# ALA_PG_POOL=1
# ALA_PG_POOL_MIN=1
# ALA_PG_POOL_MAX=10

# --- Session cookies ---
# ALA_SESSION_COOKIE=ala_session
# ALA_CSRF_COOKIE=ala_csrf
# ALA_SESSION_MAX_AGE=43200
# ALA_COOKIE_SECURE=0
# ALA_COOKIE_SAMESITE=lax
# Production HTTPS: ALA_COOKIE_SECURE=1

# --- Rate limits (auth) ---
# ALA_RATE_LIMIT_LOGIN=20
# ALA_RATE_LIMIT_LOGIN_WINDOW=60
# ALA_RATE_LIMIT_REGISTER=10
# ALA_RATE_LIMIT_REGISTER_WINDOW=60
# ALA_RATE_LIMIT_DISABLED=0

# --- AI model providers ---
# ALA_MODEL_PROVIDER=safe_local
# ALA_OLLAMA_URL=http://127.0.0.1:11434
# ALA_OLLAMA_MODEL=llama3.2
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ANTHROPIC_API_KEY=
# External cloud LLMs require explicit enable after privacy review:
# ALA_ALLOW_EXTERNAL_LLM=0
# ALA_WEB_RESEARCH=0
# ALA_BC_LAWS_OFFLINE=0
# ALA_OCR_DISABLED=0

# --- Object storage / queue (optional compose stack) ---
# ALA_REDIS_URL=redis://localhost:6379/0
# ALA_S3_ENDPOINT=http://localhost:9000
# ALA_S3_ACCESS_KEY=ala_minio
# ALA_S3_SECRET_KEY=change_me

# --- Public demo safety (must stay restrictive for public Spaces) ---
# PUBLIC_DEMO=0
# ALLOW_CLIENT_UPLOADS=0
# ALLOW_COURT_READY_EXPORTS=0
# ALLOW_PUBLIC_PERSISTENCE=0
# ALLOW_PUBLIC_CONNECTORS=0

# --- Frontend (Vite) ---
# VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_APP_MODE=private

# --- CI / publish (never in client images) ---
# HF_TOKEN=
# GH_TOKEN=
